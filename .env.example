# Copy to .env.local and adjust.

# FastAPI backend. /api/v1/* and /media/* are proxied there, so session cookies stay on this origin.
API_URL=http://127.0.0.1:8000

# Public URL of this site (used for absolute links in metadata / social previews).
SITE_URL=http://localhost:3000

# Private address of the admin sign-in page (server-only, never sent to browsers). The website never links to it, and
# every other /admin URL answers 404 until an admin signs in. Must be /admin/ + at least 12 letters, digits, - or _.
# Leave empty to switch admin sign-in off. Generate one with:
#   node -e "console.log('/admin/' + require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_LOGIN_PATH=

# Copy to .env.local and adjust.

# FastAPI backend. /api/v1/* and /media/* are proxied there, so session cookies stay on this origin.
API_URL=http://127.0.0.1:8000

# Public URL of this site (absolute links in social previews, sitemap.xml and robots.txt). Set it before building.
SITE_URL=http://localhost:3000

# Optional: the code from Google Search Console's "HTML tag" verification (only the content="..." value).
GOOGLE_SITE_VERIFICATION=

# Private address of the admin sign-in page (server-only, never sent to browsers). The website never links to it, and
# every other /admin URL answers 404 until an admin signs in. Must be /admin/ + at least 12 letters, digits, - or _.
# Leave empty to switch admin sign-in off. Generate one with:
#   node -e "console.log('/admin/' + require('crypto').randomBytes(12).toString('base64url'))"
ADMIN_LOGIN_PATH=

# Error alerts with Sentry (sentry.io, free plan): the project's DSN, for the server (SENTRY_DSN) and the browser
# (NEXT_PUBLIC_SENTRY_DSN, read at build time). Leave both empty to switch alerts off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
